{
  "name": "jams-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JAMS — Job Application Management System backend (FastAPI-blueprint ported to Node/TS: envelope API, scoring, streaks, analytics, ingestion)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit && esbuild src/serverless.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.js --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.14",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
